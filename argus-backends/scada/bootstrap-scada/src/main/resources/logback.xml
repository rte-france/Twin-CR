    </logger>
    <logger name="com.rte_france.powsybl.iidm.import_.die.GeneratorHelperDie" level="ERROR" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.rte_france.powsybl.iidm.import_.die.BusBarHelperDie" level="ERROR" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="org.TwinCR.argus_backends.common.gridmodel.GridModel" level="ERROR" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
