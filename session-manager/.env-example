AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GARAGE_HOST=garage
GARAGE_PORT=3900
BUCKET=context-library
CONFIGURATOR_HOST=configurator-client
CONFIGURATOR_EXPOSED_PORT=8080
SESSION_MANAGER_EXPOSED_PORT=8090
NO_PROXY=localhost,garage,configurator-client  # [native] the container unsets proxies
no_proxy=localhost,garage,configurator-client  # [native] the container unsets proxies
# Echo every SQL statement and its bound parameters (includes access-key
# passwords in clear). Debugging only.
# DB_ECHO=1
#DB_URL=
KEYCLOAK_REALM=twincr
KEYCLOAK_CLIENT_ID=session-manager-client

# Native runs only (uv, other services in docker): uncomment and adapt.
# Defaults are the in-container paths used by docker.
#KEYCLOAK_VERIFY_TLS=false  # [native] Keycloak's host port serves a self-signed cert
#KEYCLOAK_INTERNAL_URL=https://localhost  # [native] default http://keycloak:8080
#SIMULATORS_PATH=/home/session-manager/simulators  # [native]
#EXTRA_RULES_PATH=/home/session-manager/dynawo_rules  # [native]

# Nomad infrastructure only (set by its session-manager job, see infra/roles/session_manager): each session runs as a
# Nomad job. Leave NOMAD_ADDR unset with compose (single session, at CONFIGURATOR_CLIENT_ENDPOINT).
#NOMAD_ADDR=http://127.0.0.1:4646  # [native] enables the Nomad mode
#NOMAD_TOKEN=  # [native] ACL token (in the infra: the workload identity of the job)
#SESSION_JOB_HCL=  # [native] session job; default: docs/infra/twincr-session.nomad.hcl of the repository (image: its copy)
#SESSION_JOB_VARIABLES=  # [native] HCL assignments added to each session job, separated by \n (e.g. registry = "10.0.0.1:5000")
#SESSION_INIT_TIMEOUT=600  # [native] seconds for the session services to start and initialize, once placed
#SESSION_PUBLIC_URL=  # [native] public base URL of the session routes given to Argus (e.g. https://localhost/sessions)
#SESSION_ROUTER_URL=  # [native] Traefik as reached by the session manager, to wait for the session routes (e.g. https://127.0.0.1)
