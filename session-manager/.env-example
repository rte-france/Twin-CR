AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GARAGE_HOST=garage
GARAGE_PORT=3900
BUCKET=context-library
CONFIGURATOR_HOST=configurator-client
CONFIGURATOR_EXPOSED_PORT=8080
SESSION_MANAGER_EXPOSED_PORT=8090
NO_PROXY=localhost,garage,configurator-client  # [native] the container unsets proxies
no_proxy=localhost,garage,configurator-client  # [native] the container unsets proxies
# Echo every SQL statement and its bound parameters (includes access-key
# passwords in clear). Debugging only.
# DB_ECHO=1
#DB_URL=
KEYCLOAK_REALM=twincr
KEYCLOAK_CLIENT_ID=session-manager-client

# Native runs only (uv, other services in docker): uncomment and adapt.
# Defaults are the in-container paths used by docker.
#KEYCLOAK_VERIFY_TLS=false  # [native] Keycloak's host port serves a self-signed cert
#KEYCLOAK_INTERNAL_URL=https://localhost:8443  # [native] default http://keycloak:8080
#SIMULATORS_PATH=/home/session-manager/simulators  # [native]
#EXTRA_RULES_PATH=/home/session-manager/dynawo_rules  # [native]
