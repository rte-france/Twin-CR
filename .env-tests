# Storage system
MODE=CLICKHOUSE   # Config server "storage backend", the other option is FILESYSTEM, for dev use only
CONFIG_PATH=docs/orchestrator/examples/Nordic/config.toml  # Only used if FILESYSTEM, update with the config you want to run

# Clickhouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=gamemaster
CLICKHOUSE_EXPOSED_PORT=8123

# DSL
WITH_TESTS=ON
WITH_LEGACY_DSL=false  # Set to true to use the legacy Python gamemaster instead of the new C++ DSLEngine
# Which container serves the DSL API: twincr-core for the C++ engine, gamemaster for the legacy one.
DSL_SERVER_HOST=twincr-core
DSL_SERVER_PORT=8000
DSL_SERVER_EXPOSED_PORT=8000
# Legacy only: unused unless WITH_LEGACY_DSL=true and the stack is started with --profile legacy_dsl.
# The gamemaster keeps its own host port so it never collides with the C++ engine's.
LEGACY_DSL_SERVER_EXPOSED_PORT=8001
GAMEMASTER_IIDM_BUCKET=iidm-files
GAMEMASTER_DSL_BUCKET=dsl-files

# Game Master backend location
GAMEMASTER_BACKEND_HOST=argus-backend-gm
GAMEMASTER_BACKEND_PORT=8083
GAMEMASTER_BACKEND_EXPOSED_PORT=8083

# SCADA backend location
SCADA_BACKEND_HOST=argus-backend-scada
SCADA_BACKEND_PORT=8082
SCADA_BACKEND_EXPOSED_PORT=8082

# NATS
NATS_HOST=nats
NATS_PORT=4222
NATS_EXPOSED_PORT=4222

# Configurator Server & Client
GARAGE_HOST=garage
GARAGE_PORT=3900
GARAGE_EXPOSED_PORT=3900
# AWS_ACCESS_KEY_ID=  # Taken from .env when running locally, automatically appended when running from github actions
# AWS_SECRET_ACCESS_KEY=
# GARAGE_RPC_SECRET=  # Taken from .env when running locally, generated for each run on github actions (setup.sh --only secrets)
# GARAGE_ADMIN_TOKEN=
# GARAGE_METRICS_TOKEN=
STORAGE_TYPE=S3

# Configurator Client
CONFIGURATOR_HOST=configurator-client
CONFIGURATOR_PORT=8080
CONFIGURATOR_EXPOSED_PORT=8080

# Session manager
AWS_ENDPOINT_URL_S3=http://garage:3900
BUCKET=context-library
SESSION_MANAGER_EXPOSED_PORT=8090
DYNAWO_HOME=./simulators/dynawo

# Keycloak
KEYCLOAK_PORT=8443
# KEYCLOAK_ADMIN_PASSWORD=  # Taken from .env when running locally, generated for each run on github actions

# Dynawo
FETCH_PUBLIC_DYNAWO=true
GITHUB_TOKEN=
