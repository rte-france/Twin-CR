FROM --platform=linux/amd64 devraymondsh/ubuntu-rust:jammy-latest AS builder

# Set environment variables to avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y software-properties-common && add-apt-repository -y universe \
    && rm -rf /var/lib/apt/lists/*

# Tauri and build dependencies
# Note: libwebkit2gtk dev package name varies by distro version; try 4.1 then 4.0
RUN apt-get update \
    && apt-get install -y \
        xdg-utils libfuse2 \
        build-essential curl wget file \
        libssl-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
        pkg-config clang mold git zstd \
    && (apt-get install -y libwebkit2gtk-4.1-dev || apt-get install -y libwebkit2gtk-4.0-dev) \
    && rm -rf /var/lib/apt/lists/*

# GUI and display dependencies for running in container
RUN apt-get update \
    && apt-get install -y xvfb x11-utils x11-apps dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js and npm (the nodesource setup script runs apt-get update itself)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs

# Enable pnpm via corepack (bundled with Node.js 24)
ENV NODE_USE_ENV_PROXY=1
RUN corepack enable && corepack prepare pnpm@latest --activate && npm i -g typescript

COPY argus argus
COPY envs/bundle.sh /tmp

WORKDIR /argus

# Install JS deps
ENV CI=true
RUN pnpm install || pnpm approve-builds esbuild msgpackr-extract unrs-resolver

#RUN pnpm up --latest  # Might need to be removed? (opposite of lock file)

# Patch the build script to skip TypeScript compilation
RUN sed -i 's/tsc && vite build/vite build/' package.json

# Build argus debug and release version
RUN (rm /argus/bundle.log.* || /bin/true) && /tmp/bundle.sh && zstd --rm /argus/bundle.log.*

FROM ubuntu:jammy

# Set environment variables to avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y apt-utils kmod libfuse2 \
    && (apt-get install -y libwebkit2gtk-4.1-dev || apt-get install -y libwebkit2gtk-4.0-dev) \
    && apt-get autoremove -y && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chmod=555 /argus/*.AppImage /argus/bundle.log.* /app/
