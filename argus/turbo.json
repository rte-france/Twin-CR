{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "HTTP_PROXY",
    "http_proxy",
    "HTTPS_PROXY",
    "https_proxy",
    "NO_PROXY",
    "no_proxy"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "tauri:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*",
        "src-tauri/src/**/*",
        "src-tauri/Cargo.toml",
        "src-tauri/tauri.conf.json"
      ],
      "outputs": ["src-tauri/target/release/bundle/**/*"]
    },
    "tauri:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
