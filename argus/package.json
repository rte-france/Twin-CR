{
  "name": "argus",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "tauri": "pnpm --filter ./apps/argus exec tauri",
    "tauri:build": "turbo run tauri:build",
    "tauri:dev": "turbo run tauri:dev",
    "deps:lint": "syncpack lint --dependency-types prod,dev",
    "deps:fix": "syncpack fix",
    "deps:audit": "knip --dependencies",
    "deps:clean": "knip --fix --fix-type dependencies",
    "deadcode": "knip",
    "test": "turbo run test:ui test:tauri",
    "test:ui": "turbo run test:ui",
    "test:tauri": "turbo run test:tauri"
  },
  "devDependencies": {
    "knip": "^6.44.2",
    "syncpack": "^14.3.1",
    "turbo": "^2.9.18"
  }
}
