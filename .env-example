# Storage system
MODE=CLICKHOUSE   # Config server "storage backend", the other option is FILESYSTEM, for dev use only
CONFIG_PATH=docs/orchestrator/examples/Nordic/config.toml  # Only used if FILESYSTEM, update with the config you want to run

# Argus backends
ARGUS_BACKENDS_BUILD_VARIANT=public  # Set to "public" to build argus-backends without the private powsybl-rte jars/estim binary (state estimation disabled in the scada image)

# Argus: URL of the HERGE GIS viewer's ArcGIS REST services, used until one is saved in its configuration panel
# (default http://localhost:6080/arcgis/rest/services/HERGE)
# HERGE_URL=

# Mac (/ Windows?) only, uncomment to be able to use the Python HMI
# DOCKER_DISPLAY=host.docker.internal:0

# Clickhouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=gamemaster
CLICKHOUSE_EXPOSED_PORT=8123

# DSL
# Set to ON to also compile the DSL regression suite and run it inside the orchestrator image build
WITH_TESTS=OFF
WITH_LEGACY_DSL=false  # Set to true to use the legacy Python gamemaster instead of the new C++ DSLEngine
# Which container serves the DSL API: twincr-core for the C++ engine, gamemaster for the legacy one.
DSL_SERVER_HOST=twincr-core
DSL_SERVER_PORT=8000
DSL_SERVER_EXPOSED_PORT=8000
# Legacy only: unused unless WITH_LEGACY_DSL=true and the stack is started with --profile legacy_dsl.
# The gamemaster keeps its own host port so it never collides with the C++ engine's.
LEGACY_DSL_SERVER_EXPOSED_PORT=8001
GAMEMASTER_IIDM_BUCKET=iidm-files
GAMEMASTER_DSL_BUCKET=dsl-files

# Game Master backend location
GAMEMASTER_BACKEND_HOST=argus-backend-gm
GAMEMASTER_BACKEND_PORT=8083
GAMEMASTER_BACKEND_EXPOSED_PORT=8083

# SCADA backend location
SCADA_BACKEND_HOST=argus-backend-scada
SCADA_BACKEND_PORT=8082
SCADA_BACKEND_EXPOSED_PORT=8082

# Configurator Server & Client
GARAGE_HOST=garage
GARAGE_PORT=3900
GARAGE_EXPOSED_PORT=3900
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CONTEXT_BUCKET=context-library
ARCHIVE_BUCKET=archive
STORAGE_TYPE=S3
# Garage server secrets (required by configurator_server/docker-compose-garage.yaml), generated by setup.sh
GARAGE_RPC_SECRET=  # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=  # openssl rand -base64 32
GARAGE_METRICS_TOKEN=  # openssl rand -base64 32

# Configurator Client
CONFIGURATOR_HOST=configurator-client
CONFIGURATOR_PORT=8080
CONFIGURATOR_EXPOSED_PORT=8080

# Session manager
# Path to dynawo home used by Configurator in main_configure()
DYNAWO_HOME=./simulators/dynawo
SESSION_MANAGER_EXPOSED_PORT=8090
CACHE_DIR=.cache
NO_AUTH=FALSE

# Keycloak
KEYCLOAK_PORT=8443
KEYCLOAK_REALM=twincr
KEYCLOAK_CLIENT_ID=session-manager-client
KEYCLOAK_ADMIN=admin  # Admin of the master realm, also used by keycloak-seed
KEYCLOAK_ADMIN_PASSWORD=  # Generated by setup.sh (openssl rand -base64 32)

# NATS
NATS_HOST=nats
NATS_PORT=4222
NATS_EXPOSED_PORT=4222

# Dynawo
FETCH_PUBLIC_DYNAWO=false  # Fetch public dynawo local release, if private dynawo is not necessary
GITHUB_TOKEN=  # Github token to fetch private dynawo release

TZ=Europe/Paris  # Specify your own timezone
