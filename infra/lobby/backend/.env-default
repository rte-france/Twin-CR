# ==========================================
# FASTAPI APP SETTINGS
# ==========================================
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# TRAEFIK (Routing)
# ==========================================
# Base domain used to generate session URLs (e.g., sess-456.twin.local)
BASE_DOMAIN=localhost

# ==========================================
# INFRASTRUCTURE / ORCHESTRATION
# ==========================================
# Nomad API
NOMAD_URL=http://127.0.0.1:4646
NOMAD_TOKEN=

# Consul API
CONSUL_URL=http://127.0.0.1:8500
CONSUL_TOKEN=

# Temporal (gRPC usually runs on 7233, without http prefix)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

DATABASE_URL=postgresql+asyncpg://url:password@127.0.0.1:5433/twineu
S3_ENDPOINT_URL=http://s3.localhost
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=twineu-files

# ==========================================
# IDENTITY (Keycloak)
# ==========================================
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=grid-twin
KEYCLOAK_CLIENT_ID=twin-api
KEYCLOAK_CLIENT_SECRET=my-super-secret
