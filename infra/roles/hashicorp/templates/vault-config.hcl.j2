ui = true
disable_mlock = true

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "node1"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = "true"
}

api_addr = "http://{{ ansible_facts['default_ipv4']['address'] }}:8200"
cluster_addr = "https://{{ ansible_facts['default_ipv4']['address'] }}:8201"
