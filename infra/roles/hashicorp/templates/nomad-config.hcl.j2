datacenter = "dc1"
data_dir  = "/opt/nomad"
bind_addr = "0.0.0.0"

advertise {
  http = "{{ ansible_facts['default_ipv4']['address'] }}"
  rpc  = "{{ ansible_facts['default_ipv4']['address'] }}"
  serf = "{{ ansible_facts['default_ipv4']['address'] }}"
}

server {
  enabled          = {{ 'true' if inventory_hostname in groups['nomad_servers'] else 'false' }}
  bootstrap_expect = 1

  # Tasks reserve their typical memory (memory) and may use up to memory_max, so that a session fits on small nodes.
  # Only applied when the cluster is bootstrapped: the hashicorp role also sets it on existing ones.
  default_scheduler_config {
    memory_oversubscription_enabled = true
  }
}

client {
  enabled    = true
  node_class = "{{ 'control-plane' if inventory_hostname in groups['nomad_servers'] else 'compute' }}"
{% if nomad_cpu_total_compute is defined or nomad_cpu_freq_check.rc != 0 %}
  # CPU frequency not readable on this node (see the hashicorp role): capacity = cores x nomad_cpu_mhz_per_core
  cpu_total_compute = {{ nomad_cpu_total_compute | default(ansible_facts['processor_vcpus'] * (nomad_cpu_mhz_per_core | default(2000))) }}
{% endif %}
{% if inventory_hostname not in groups['nomad_servers'] %}
  servers    = ["{{ nomad_server_ip | default(hostvars[groups['nomad_servers'][0]]['ansible_facts']['default_ipv4']['address']) }}:4647"]
{% endif %}
}

plugin "docker" {
  config {
    allow_privileged = true
    volumes { enabled = true }
    infra_image = "registry.k8s.io/pause:3.3"
    pull_activity_timeout = "2m"
  }
}

consul {
  address = "127.0.0.1:8500"
}

# Vault integration via Workload Identity (JWT). No static token: Nomad signs a
# JWT per allocation, Vault validates it against Nomad's JWKS endpoint.
vault {
  enabled               = true
  address               = "http://{{ hostvars[groups['nomad_servers'][0]]['ansible_facts']['default_ipv4']['address'] }}:8200"
  jwt_auth_backend_path = "jwt-nomad"

  # The workload identity is only used by Nomad to render the Vault templates of the jobs, not exposed to the tasks
  # (env): exposing it requires change_mode = "restart", which restarts the tasks each time it is renewed (ttl), e.g.
  # the orchestrator in the middle of a simulation.
  default_identity {
    aud  = ["vault.io"]
    ttl  = "1h"
    file = true
    env  = false
  }
}

acl {
  enabled = true
}
