job "dnsmasq" {
  datacenters = ["dc1"]
  type        = "system"

  group "dns" {
    network {
      port "dns" {
        static = 53
      }
    }

    task "dnsmasq" {
      driver = "docker"

      config {
        image        = "4km3/dnsmasq:latest"
        network_mode = "host"
        args = [
          "--keep-in-foreground",
          "--log-facility=-",
          "--address=/.{{ base_domain }}/127.0.0.1"
        ]
      }

      resources {
        cpu    = 50
        memory = 64
      }
    }
  }
}
