job "traefik" {
  datacenters = ["dc1"]
  type        = "system"
  group "traefik" {
    network {
      port "http"     { static = 80 }
      port "https"    { static = 443 }
      port "admin"    { static = 8080 }
      port "lobby-api" { static = 8000 }
    }
    service {
          name = "traefik-admin"
          port = "admin"
          check {
            name     = "Traefik Ping Check"
            type     = "http"
            path     = "/ping"
            interval = "10s"
            timeout  = "2s"
          }
        }
    vault {
      role = "nomad-workloads"
    }

    task "traefik" {
      driver = "docker"
      env {
        NO_PROXY = "127.0.0.1,localhost,10.0.0.0/8,.{{ base_domain }}"
        no_proxy = "127.0.0.1,localhost,10.0.0.0/8,.{{ base_domain }}"
      }
      template {
        destination = "secrets/cert.pem"
        data        = <<EOF
{% raw %}
{{ with secret "pki/issue/twincr-workloads" "common_name=traefik.twin.local" "alt_names={% endraw %}{{ public_host }}{% raw %},keycloak.twin.local,nomad.twin.local,consul.twin.local,vault.twin.local,registry.twin.local,s3.twin.local" "ip_sans=127.0.0.1,172.28.0.2" "ttl=8760h" }}
{{ .Data.certificate }}
{{ .Data.issuing_ca }}
{{ end }}
{% endraw %}
EOF
      }
      template {
        destination = "secrets/key.pem"
        data        = <<EOF
{% raw %}
{{ with secret "pki/issue/twincr-workloads" "common_name=traefik.twin.local" "alt_names={% endraw %}{{ public_host }}{% raw %},keycloak.twin.local,nomad.twin.local,consul.twin.local,vault.twin.local,registry.twin.local,s3.twin.local" "ip_sans=127.0.0.1,172.28.0.2" "ttl=8760h" }}
{{ .Data.private_key }}
{{ end }}
{% endraw %}
EOF
      }
      template {
              destination = "local/traefik-routes.yml"
              data = <<EOF
      tls:
        certificates:
          - certFile: "/secrets/cert.pem"
            keyFile: "/secrets/key.pem"
      http:
        routers:
          auth-redirect:
            rule: "Host(`auth.{{ base_domain }}`)"
            entryPoints:
              - web
              - websecure
            middlewares:
              - auth-redirect-middleware
            service: "noop@internal"
            tls: {}
          nomad-ui:
            rule: "Host(`nomad.{{ base_domain }}`)"
            service: nomad-svc
            entryPoints:
              - web
              - websecure
            tls: {}
          consul-ui:
            rule: "Host(`consul.{{ base_domain }}`)"
            service: consul-svc
            entryPoints:
              - web
              - websecure
            tls: {}
          vault-ui:
            rule: "Host(`vault.{{ base_domain }}`)"
            service: vault-svc
            entryPoints:
              - web
              - websecure
            tls: {}
        middlewares:
          auth-redirect-middleware:
            redirectRegex:
              regex: "^https?://auth\\.[^/]+/(.*)"
              replacement: "{{ public_url }}/$${1}"
              permanent: false
        services:
          nomad-svc:
            loadBalancer:
              servers:
                - url: "http://127.0.0.1:4646"
          consul-svc:
            loadBalancer:
              servers:
                - url: "http://127.0.0.1:8500"
          vault-svc:
            loadBalancer:
              servers:
                - url: "http://127.0.0.1:8200"
      EOF
            }
      config {
        image        = "traefik:v3.7"
        network_mode = "host"
        args = [
          "--api.dashboard=true",
          "--api.insecure=true",
          "--providers.consulcatalog=true",
          "--providers.consulcatalog.exposedByDefault=false",
          "--providers.nomad=true",
          "--providers.nomad.exposedByDefault=false",
          "--ping=true",
          "--providers.nomad.endpoint.address=http://127.0.0.1:4646",
          "--providers.consulcatalog.endpoint.address=http://127.0.0.1:8500",
          "--providers.file.filename=/local/traefik-routes.yml",
          "--entrypoints.web.address=:80",
          "--entrypoints.web.http.redirections.entrypoint.to=websecure",
          "--entrypoints.web.http.redirections.entrypoint.scheme=https",
          "--entrypoints.websecure.address=:443",
          "--entrypoints.traefik.address=:8080",
          "--entrypoints.lobby-api.address=:8000",
          "--log.level=INFO",
          "--accesslog=true",
          "--accesslog.format=json",
        ]
        ports = ["http", "https", "admin", "lobby-api"]
      }
      resources {
        cpu    = 200
        memory = 256
      }
    }
  }
}
