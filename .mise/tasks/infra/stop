#!/usr/bin/env bash
#MISE description="Stop the Twin-CR local infrastructure on macOS or Linux"

set -euo pipefail

if [ "$(uname -s)" = "Darwin" ]; then
    if command -v orb >/dev/null 2>&1; then
        echo "==> Stopping OrbStack machines (twincr-dev)..."
        for vm in $(orb list 2>/dev/null | awk '/^twincr-(dev|worker)/ {print $1}'); do
            echo "  Stopping $vm..."
            orb stop "$vm" || true
        done
    fi
else
    for c in $(docker ps -a --format '{{.Names}}' | grep -E '^twincr_(target|worker_[0-9]+)$'); do
        echo "==> Stopping container $c..."
        docker stop "$c" || true
    done
fi

echo "==> Infrastructure stopped."
