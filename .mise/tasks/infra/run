#!/usr/bin/env bash
#MISE description="Deploy and manage the Twin-CR Nomad/Consul/Vault infrastructure (OS auto-detect)"
#MISE depends=["setup"]
#USAGE flag "-h --help" help="Show infra help"
#USAGE arg "[args]..." help="Options forwarded to make (e.g. NODES=2 ENV=opf)"

set -euo pipefail

cd infra

if [ ! -f .vault_pass.txt ]; then
    echo "dev" > .vault_pass.txt
fi

TARGET_ENV="dev"
NODES_COUNT="1"
FORWARD_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --env)
            TARGET_ENV="$2"
            shift 2
            ;;
        --env=*|ENV=*)
            TARGET_ENV="${1#*=}"
            shift
            ;;
        --node|--nodes)
            NODES_COUNT="$2"
            shift 2
            ;;
        --node=*|--nodes=*)
            NODES_COUNT="${1#*=}"
            shift
            ;;
        NODES=*)
            NODES_COUNT="${1#NODES=}"
            shift
            ;;
        *)
            FORWARD_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ "$TARGET_ENV" = "dev" ]; then
    # Local backend: OrbStack VMs (mac task) or Docker containers (linux task, also used with Docker Desktop on macOS).
    BACKEND="${TWINCR_INFRA_BACKEND:-}"
    if [ -z "$BACKEND" ]; then
        if [ "$(uname -s)" = "Darwin" ] && command -v orb >/dev/null 2>&1; then
            BACKEND="orbstack"
        else
            BACKEND="docker"
        fi
    fi
    if [ "$BACKEND" = "orbstack" ]; then
        ../.mise/tasks/infra/mac --nodes="${NODES_COUNT}" ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
    elif [ "$BACKEND" = "docker" ]; then
        ../.mise/tasks/infra/linux --nodes="${NODES_COUNT}" ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
    else
        echo "ERROR: unknown TWINCR_INFRA_BACKEND='${BACKEND}' (expected orbstack or docker)" >&2
        exit 1
    fi
    ../.mise/tasks/infra/push
    # The applications (session manager) are deployed once their images are in the registry
    exec make apps
fi

# Generic deployment (e.g. ENV=opf). Then, once the images are in its registry: make apps ENV=...
make deploy ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
