<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="PL1_state" lib="DYNModelUpdatableInteger"/>
  <dyn:connect id1="PL1_state" var1="input_variable" id2="NETWORK" var2="PL1_state_value"/>

  <dyn:blackBoxModel id="G2_state" lib="DYNModelUpdatableBoolean"/>
  <dyn:connect id1="G2_state" var1="input_variable" id2="G2" var2="generator_switchOffSignal2"/>

  <dyn:blackBoxModel id="L2_state" lib="DYNModelUpdatableBoolean"/>
  <dyn:connect id1="L2_state" var1="input_variable" id2="L2" var2="load_switchOffSignal2"/>

  <dyn:blackBoxModel id="LoadReduction" lib="DYNModelUpdatableContinuous"/>
  <dyn:connect id1="LoadReduction" var1="input_variable" id2="L2" var2="load_deltaP"/>
</dyn:dynamicModelsArchitecture>
