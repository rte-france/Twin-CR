{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandInjectionReceivedCommandRequest",
  "description": "Inject a ControlReceived command in the simulation (bypasses cyber layer)",
  "allOf": [
    { "$ref": "start_time.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "command_injection_received"
        },
        "command_id": {
          "type": "string",
          "description": "ID of the command to send"
        },
        "value": {
          "type": "number",
          "description": "Value of the command to send"
        },
        "source": {
          "$ref": "node.json"
        },
        "destination": {
          "$ref": "node.json"
        }
      },
      "required": [
        "command",
        "command_id",
        "value",
        "source",
        "destination"
      ]
    }
  ]
}
