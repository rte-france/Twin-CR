          "properties": {
            "delay_function": {
              "$ref": "delay_function.json"
            },
            "drop_function": {
              "$ref": "drop_function.json"
            },
            "corruption_functions": {
              "type": "array",
              "items": {
                "$ref": "corruption_function.json"
              }
            }
          },
          "required": [
            "delay_function",
            "drop_function",
            "corruption_functions"
          ]
        }
      },
      "required": ["status", "reply"]
    }
  ]
}
