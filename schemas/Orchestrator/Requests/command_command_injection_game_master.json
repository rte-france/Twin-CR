{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandInjectionGameMasterCommandRequest",
  "description": "Inject an ActualControl command in the simulation",
  "allOf": [
    { "$ref": "start_time.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "command_injection_game_master"
        },
        "command_id": {
          "type": "string",
          "description": "ID of the command to send"
        },
        "value": {
          "type": "number",
          "description": "Value of the command to send"
        }
      },
      "required": [
        "command",
        "command_id",
        "value"
      ]
    }
  ]
}
