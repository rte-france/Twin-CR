{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "description": "Error response sent by the orchestrator when a request cannot be satisfied",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "not": {
        "enum": ["OK", "READY", "STARTED"]
      },
      "description": "Human-readable error message"
    }
  },
  "required": ["status"]
}
