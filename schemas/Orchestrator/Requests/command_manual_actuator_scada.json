{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManualActuatorScadaCommandRequest",
  "description": "Emulate a manual actuator action for the SCADA side",
  "allOf": [
    { "$ref": "start_time.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "manual_actuator_scada"
        },
        "command_id": {
          "type": "string",
          "description": "ID of the command to send"
        },
        "value": {
          "type": "number",
          "description": "Value of the command to send"
        },
        "topic": {
          "type": "string",
          "description": "Topic of the command"
        }
      },
      "required": [
        "command",
        "command_id",
        "value",
        "topic"
      ]
    }
  ]
}
