{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IidmCommandRequest",
  "description": "Inject an ActualControl command in the simulation based on IIDM ID",
  "allOf": [
    { "$ref": "start_time.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "iidm_command"
        },
        "iidm_id": {
          "type": "string",
          "description": "IIDM ID of the element"
        },
        "attribute": {
          "$ref": "iidm_attribute.json"
        },
        "value": {
          "type": "number",
          "description": "Value of the command to send"
        }
      },
      "required": ["command", "iidm_id", "attribute", "value"]
    }
  ]
}
