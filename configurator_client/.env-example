CLICKHOUSE_HOST=localhost  # [native] in docker, taken from the root .env
CLICKHOUSE_PORT=8123
DSL_SERVER_HOST=localhost  # [native] in docker, taken from the root .env
DSL_SERVER_PORT=8000
NATS_URL=nats://localhost:4222  # [native] in docker, set by the compose environment
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
